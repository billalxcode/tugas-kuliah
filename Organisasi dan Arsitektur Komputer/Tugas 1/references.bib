@techReport{RevaAmalia2024,
   abstract = {Perkembangan komputer telah mengalami lonjakan yang luar biasa dalam beberapa
dekade terakhir. Dengan berkembangnya teknologi, komputer menjadi lebih terjangkau dan
dapat diakses oleh masyarakat umum dan peran komputer semakin vital dalam berbagai aspek
kehidupan manusia, mulai dari pendidikan, bisnis, hiburan, hingga riset ilmiah. Komputer
modern terdiri dari komponen - komponen utama seperti CPU (Central Processing Unit), RAM
(Random Access Memory), storage, dan perangkat I/O. Perkembangan teknologi komputer
terus mengalami peningkatan dalam hal kecepatan, kapasitas penyimpanan, dan kemampuan
pemrosesan, memungkinkan pengguna untuk menjalankan aplikasi yang lebih kompleks dan
memanfaatkan data dengan efisien. Dengan kemampuannya yang terus berkembang, komputer
menjadi tulang punggung bagi berbagai inovasi dan progres di berbagai bidang kehidupan.
Oleh karena itu, pemahaman mendalam tentang teknologi komputer yaitu untuk
memanfaatkannya secara bijak dan efektif demi kemajuan masyarakat dan dunia pada
umumnya.},
   author = {Vanessa Reva Amalia and Herawan Hayadi and Furtasan Ali Yusuf and Eni Feriyanti and Putri Aulia Suryani},
   institution = {Universitas Bina Bangsa},
   title = {PERKEMBANGAN KOMPUTER DARI MASA KE MASA},
   url = {https://www.academia.edu/114238116/PERKEMBANGAN_KOMPUTER_DARI_MASA_KE_MASA},
   year = {2024}
}
@book{IKadekBramastaPutraDewangga2025,
   abstract = {Komputer merupakan salah satu pencapaian teknologi terbesar dalam
sejarah manusia. Makalah ini membahas perkembangan komputer dari
generasi pertama hingga generasi kelima, yang menunjukkan perubahan
signifikan dalam ukuran, kecepatan, dan kemampuan. Selain itu, dibahas pula
evolusi sistem operasi, mulai dari sistem sederhana hingga sistem modern
seperti time sharing, distributed system, dan perangkat genggam, yang
berkembang seiring kemajuan perangkat keras dan perangkat lunak.
Perjalanan ini tidak lepas dari kontribusi tokoh-tokoh penting seperti
Charles Babbage, Alan Turing, dan John von Neumann, yang meletakkan dasar
bagi teori, arsitektur, dan pemrograman komputer. Dampak komputer
terhadap kehidupan juga sangat luas, mencakup bidang pendidikan, industri,
kesehatan, hingga pemerintahan, dengan peran utama dalam meningkatkan
efisiensi, produktivitas, dan akses informasi.
Pada akhirnya, makalah ini menyoroti tren masa kini dan masa depan,
seperti komputasi awan, kecerdasan buatan, dan Internet of Things, yang
menunjukkan bahwa komputer akan terus berkembang adaptif sesuai
kebutuhan manusia.},
   author = {I Kadek Bramasta Putra Dewangga and I Kadek Agus Arya Purnawan and I Nyoman Dharma Wikananda and I Made Wahyu Wardhana and Gusti Ngurah Krisna Widnyana},
   city = {Denpasar},
   isbn = {2501010051},
   pages = {1-12},
   title = {Sejarah dan Perkembangan Komputer serta Sistem Operasi di
Era Digital},
   url = {https://www.academia.edu/144512398/Makalah_Sejarah_dan_Perkembangan_Komputer_serta_Oprasi_di_Era_Digital},
   year = {2025}
}
